.nuxt/
.cache/
.svelte-kit/
.temp/
.docusaurus/
.vuepress/dist/
**/.vitepress/dist/
**/.vitepress/cache/

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/


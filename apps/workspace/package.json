{
  "name": "@verdant/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 18787 --strictPort",
    "build": "tsc --noEmit && vite build",

{
  "name": "@verdant/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test dist/ir/figures.test.js dist/ir/sectionPath.test.js dist/ir/hierarchy.test.js dist/ir/compile.test.js dist/pdfText.test.js dist/rateLimit.test.js dist/db/db.test.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.758.0",
    "@aws-sdk/client-bedrock-runtime": "^3.758.0",
    "@langfuse/otel": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@libsql/client": "^0.15.15",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "marked": "^15.0.0",
    "openai": "^4.104.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}

FROM ghcr.io/astral-sh/uv:0.8.16-python3.12-bookworm-slim@sha256:190d69899a7a73b22460b2779f85d2d65fddf9bcb05037d4463beaf52310a919
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PREFECT_HOME=/tmp/prefect
COPY pyproject.toml uv.lock LICENSE ./
COPY src ./src
RUN uv sync --locked --no-dev --group workflows
ENV PATH="/app/.venv/bin:$PATH"
USER 10001:10001
CMD ["python", "-m", "verdant.workflow_runtime", "dispatch"]

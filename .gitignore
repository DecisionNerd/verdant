# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# Verdant local data (keep placeholders + sample fixture)
data/inputs/**
!data/inputs/.gitkeep
!data/inputs/sample.png
data/outputs/**
!data/outputs/.gitkeep
data/jobs/**
!data/jobs/.gitkeep
data/turso/**
!data/turso/.gitkeep
data/datasets/**/_langfuse-sync.json
!data/datasets/sample-flowchart/**
data/config.json
data/config.json.migrated

# Trigger self-host checkout
infra/trigger/platform/

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# ── Framework / package build artifacts (any workspace package) ──────
# Patterns without a leading slash match in every package under apps/,
# packages/, trigger/, etc.

# Next.js
.next/
out/

# Astro / Starlight (types, content cache — regenerated on build/dev)
.astro/

# Generic compile / emit dirs
dist/
.output/
build/


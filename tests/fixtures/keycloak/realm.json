{
  "realm": "verdant-qualification",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 120,
  "ssoSessionIdleTimeout": 1800,
  "groups": [
    {
      "name": "workspace"
    }
  ],
  "clientScopes": [
    {
      "name": "verdant",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      }
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "verdant-browser",
      "name": "Verdant test-only browser",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "verdant-test-only-browser-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:18787/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:18787"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:18787/?signed_out=1"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "profile",
        "email"
      ]
    },
    {
      "clientId": "verdant-worker",
      "name": "Verdant test-only service",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "verdant-test-only-worker-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "verdant"
      ],
      "protocolMappers": [
        {
          "name": "verdant-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "verdant-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "owner",
      "email": "owner@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Olivia",
      "lastName": "Owner",
      "groups": [
        "/workspace"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "verdant-test-only-owner",
          "temporary": false
        }
      ]
    },
    {
      "username": "denied",
      "email": "denied@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Daniel",
      "lastName": "Denied",
      "credentials": [
        {
          "type": "password",
          "value": "verdant-test-only-denied",
          "temporary": false
        }
      ]
    },
    {
      "username": "no-grants",
      "enabled": true,
      "firstName": "Nora",
      "lastName": "No Grants",
      "email": "no-grants@example.test",
      "emailVerified": true,
      "groups": [
        "/workspace"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "verdant-test-only-no-grants",
          "temporary": false
        }
      ]
    }
  ]
}
